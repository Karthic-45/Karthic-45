name: Profile Summary Cards

on:
  schedule:
    # Runs every day at 00:30 UTC (06:00 IST)
    - cron: "30 0 * * *"
  workflow_dispatch:   # lets you run it manually from the Actions tab
  push:
    branches: [main]

jobs:
  build:
    runs-on: ubuntu-latest
    name: generate-profile-summary-cards
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v4

      - uses: vn7n24fzkq/github-profile-summary-cards@release
        env:
          # Start with the built-in token. If some cards are missing or you see
          # "Resource not accessible by integration", create a classic PAT with
          # `repo` + `read:user` scope, save it as a repo secret named
          # SUMMARY_GITHUB_TOKEN, and swap the line below to:
          #   GITHUB_TOKEN: ${{ secrets.SUMMARY_GITHUB_TOKEN }}
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        with:
          USERNAME: ${{ github.repository_owner }}
          BRANCH_NAME: "main"   # change to "master" if that's your default branch
          UTC_OFFSET: 5         # India is UTC+5:30; 5 is the closest integer
